<?xml version="1.0" encoding="utf-8"?>
<!--
  Build-only unattend injected into the base VHDX at W:\Windows\Panther\unattend.xml
  by prepare-base-vhdx.ps1. Its ONLY job is to make the bake VM boot FULLY UNATTENDED
  and let Packer connect: auto-answer region/keyboard, bypass the Win11 24H2 network/
  MSA requirement, create a local admin, auto-logon once, set a static IP on the NAT
  switch, and enable WinRM. This account/config is scrubbed by sysprep-generalize.ps1
  before capture, so it never ships in the golden WIM.

  Modeled on the proven MDC1Windows/base-autounattend.xml (NUC installs). We DISM-apply
  the image ourselves, so the windowsPE (Setup) pass is intentionally omitted.

  Tokens replaced by prepare-base-vhdx.ps1: @@WINRM_USER@@, @@WINRM_PASSWORD@@, @@COMPUTERNAME@@
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <ComputerName>@@COMPUTERNAME@@</ComputerName>
    </component>
    <!-- Everything Packer needs is set up HERE, in specialize: deterministic, runs as
         SYSTEM before OOBE, and does NOT depend on interactive autologon (the old
         FirstLogonCommands approach did, and its Enable-PSRemoting wouldn't create the
         listener on the NAT 'Public' network). Order matters. -->
    <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <RunSynchronous>
        <!-- Bypass the Win11 24H2 "must connect to a network / Microsoft account" OOBE gate. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg.exe add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE" /v BypassNRO /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <!-- Static IP on the NAT switch (no DHCP) so the host can reach WinRM + the VM has internet. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$a = Get-NetAdapter | Where-Object { $_.Status -eq 'Up' } | Select-Object -First 1; if (-not $a) { $a = Get-NetAdapter | Select-Object -First 1 }; New-NetIPAddress -InterfaceIndex $a.ifIndex -IPAddress 192.168.234.10 -PrefixLength 24 -DefaultGateway 192.168.234.1 -ErrorAction SilentlyContinue; Set-DnsClientServerAddress -InterfaceIndex $a.ifIndex -ServerAddresses '8.8.8.8','1.1.1.1'"</Path>
        </RunSynchronousCommand>
        <!-- Allow local-account admin tokens over the network (Packer auth). -->
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>reg.exe add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" /v LocalAccountTokenFilterPolicy /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <!-- WinRM service on. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>4</Order>
          <Path>cmd.exe /c sc config WinRM start= auto</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>5</Order>
          <Path>cmd.exe /c net start WinRM</Path>
        </RunSynchronousCommand>
        <!-- Create the HTTP listener EXPLICITLY. Unlike Enable-PSRemoting/winrm quickconfig,
             this does NOT check the network-connection profile, so it works on 'Public'. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>6</Order>
          <Path>cmd.exe /c winrm create winrm/config/Listener?Address=*+Transport=HTTP</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>7</Order>
          <Path>cmd.exe /c winrm set winrm/config/service/auth @{Basic="true"}</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>8</Order>
          <Path>cmd.exe /c winrm set winrm/config/service @{AllowUnencrypted="true"}</Path>
        </RunSynchronousCommand>
        <!-- Open 5985 for ALL firewall profiles (NAT net classifies as Public). -->
        <RunSynchronousCommand wcm:action="add">
          <Order>9</Order>
          <Path>netsh advfirewall firewall add rule name="WinRM-HTTP-In-5985" dir=in action=allow protocol=TCP localport=5985</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>

  <settings pass="oobeSystem">
    <!-- Auto-answer language/region/keyboard so OOBE never stops for input. -->
    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>0409:00000409</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Name>@@WINRM_USER@@</Name>
            <Group>Administrators</Group>
            <Password>
              <Value>@@WINRM_PASSWORD@@</Value>
              <PlainText>true</PlainText>
            </Password>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>
      <AutoLogon>
        <Enabled>true</Enabled>
        <Username>@@WINRM_USER@@</Username>
        <Password>
          <Value>@@WINRM_PASSWORD@@</Value>
          <PlainText>true</PlainText>
        </Password>
        <LogonCount>2</LogonCount>
      </AutoLogon>
      <OOBE>
        <ProtectYourPC>3</ProtectYourPC>
        <HideEULAPage>true</HideEULAPage>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
      </OOBE>
      <!-- WinRM + static IP are set up deterministically in the specialize pass above,
           so no FirstLogonCommands are needed here. Autologon just drives OOBE to a
           finished/idle state; the packer account below is what Packer authenticates as. -->
    </component>
  </settings>
</unattend>
